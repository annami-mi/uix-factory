{
  "$description": "«Жидкое стекло», тёмная схема (флагман, из Figma). Семантические цвета color/* — 1:1 с Figma collection 'semantic' (алиас + uix.alpha = composed-color). surface/* — материал компонентов, собран из ролей; значения эффектов — из компонентов Figma (plugin API). Pressed — по правилам кода (Liquid Glass).",
  "color": {
    "background": {
      "default": {
        "$type": "color",
        "$value": "#141417",
        "$description": "без чистого чёрного/белого — припылённые тона"
      }
    },
    "foreground": {
      "default": {
        "$type": "color",
        "$value": "{color.mono.snow}",
        "$description": "без чистого чёрного/белого — припылённые тона"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{color.foreground.default}",
        "$extensions": {
          "uix.alpha": 0.9
        }
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.foreground.default}",
        "$extensions": {
          "uix.alpha": 0.62
        }
      },
      "tertiary": {
        "$type": "color",
        "$value": "{color.foreground.default}",
