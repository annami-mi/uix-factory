      },
      "danger": {
        "$type": "color",
        "$value": "#ff5a5d",
        "$description": "код (a11y): текст ошибки (label/hint). status/danger #ff373b = 4.3:1 на фоне страницы; в Figma text/danger = red @ 0.4 (docs/figma-todo.md)"
