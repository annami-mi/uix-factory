    "inverted": {
      "text-primary": {
        "$type": "color",
        "$value": "{color.mono.ink}",
        "$description": "инвертированная плашка (Card tone=\"inverted\", 2026-09-26): тёмная в светлой схеме, светлая в тёмной — приём контраста материалов: основной текст"
      },
      "text-secondary": {
        "$type": "color",
        "$value": "{color.mono.ink}",
        "$description": "инвертированная плашка (Card tone=\"inverted\", 2026-09-26): тёмная в светлой схеме, светлая в тёмной — приём контраста материалов: вторичный текст",
