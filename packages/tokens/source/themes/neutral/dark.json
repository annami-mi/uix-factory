{
  "$description": "Плоская стилистика «neutral», тёмная схема. Токен-first (ADR-0003/0005): без blur, теней и блика; полупрозрачные плашки без бордеров, как у светлой схемы. Контраст проверен: текст ≥ 4.5:1.",
  "color": {
    "background": {
      "default": {
        "$type": "color",
        "$value": "#161619"
      }
    },
    "foreground": {
      "default": {
        "$type": "color",
        "$value": "#e8e8ec",
        "$description": "решение 2026-09-25: без чистого чёрного/белого — припылённые тона, иерархия текста мягче (docs/figma-todo.md)"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#e8e8ec"
      },
      "secondary": {
        "$type": "color",
        "$value": "#a6a6ae"
      },
      "tertiary": {
        "$type": "color",
        "$value": "#9a9aa2",
        "$description": "5.9:1 на плашке поля"
      },
      "disabled": {
        "$type": "color",
        "$value": "#5c5c63"
      },
      "on-accent": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "danger": {
        "$type": "color",
        "$value": "#ff6b6b"
      },
      "link": {
        "$type": "color",
        "$value": "#7aa2f7",
        "$description": "текст ссылки ≥ 4.5:1 на фоне и плашках (акцент как текст на тёмном фоне не проходит)"
      }
    },
    "icon": {
      "primary": {
        "$type": "color",
        "$value": "{color.foreground.default}"
